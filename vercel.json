{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/distribution",
      "destination": "/company",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/company",
      "permanent": true
    },
    {
      "source": "/shipping",
      "destination": "/refund-policy",
      "permanent": true
    },
    {
      "source": "/refund",
      "destination": "/refund-policy",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/login",
      "destination": "/app"
    },
    {
      "source": "/my",
      "destination": "/app"
    },
    {
      "source": "/diagnosis/new",
      "destination": "/app"
    },
    {
      "source": "/diagnosis/result/(.*)",
      "destination": "/app"
    }
  ]
}
