{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/distribution",
      "destination": "/company",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/company",
      "permanent": true
    },
    {
      "source": "/shipping",
      "destination": "/refund-policy",
      "permanent": true
    },
    {
      "source": "/refund",
      "destination": "/refund-policy",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/stock",
      "destination": "/app"
    },
    {
      "source": "/login",
      "destination": "/app"
    },
    {
      "source": "/my",
      "destination": "/app"
    },
    {
      "source": "/diagnosis/new",
      "destination": "/app"
    },
    {
      "source": "/diagnosis/result/(.*)",
      "destination": "/app"
    }
  ],
  "headers": [
    {
      "source": "/stock-sw.js",
      "headers": [
        { "key": "Service-Worker-Allowed", "value": "/stock" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/stock-manifest.json",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/stock",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
