{
  "name": "alfs-promo-video",
  "private": true,
  "version": "1.0.0",
  "description": "오륜미네랄 홍보 영상 10초·5초 (Remotion)",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render OryunPromo10 ../public/video/oryun-promo-10s.mp4 --codec=h264 --crf=22",
    "render:webm": "remotion render OryunPromo10 ../public/video/oryun-promo-10s.webm --codec=vp9 --crf=34",
    "bgm": "python3 scripts/make-bgm.py",
    "render:music": "remotion render OryunPromo10Music ../public/video/oryun-promo-10s-music.mp4 --codec=h264 --crf=22 --audio-codec=aac --audio-bitrate=192k",
    "render:5s": "remotion render OryunPromo ../public/video/oryun-promo.mp4 --codec=h264 --crf=22",
    "render:5s:webm": "remotion render OryunPromo ../public/video/oryun-promo.webm --codec=vp9 --crf=34",
    "poster": "remotion still OryunPromo10 ../public/video/oryun-promo-poster.webp --frame=260 --image-format=webp"
  },
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.538"
  }
}
